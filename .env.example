# Which folders and files the bot may read is set in settings.json, not here.

OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
# The checker model. 1.5B judged more accurately than 3b in eval_ab.py (5/6 vs 4/6); 3b rejected good answers.
JEV_MODEL=qwen2.5:1.5b

CHROMA_PATH=./chroma
TOP_K=8
MAX_DISTANCE=0.75
DISTANCE_MARGIN=0.12

# From api.slack.com/apps -> your app. Leave empty to run without Slack (use POST /ask).
# Bot token (xoxb-...): OAuth & Permissions. App token (xapp-..., scope connections:write): Basic Information.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional: words answers must never contain (comma separated). Defaults are in settings.py.
# BLOCKED_WORDS=invalid,incorrect,token,webhook
